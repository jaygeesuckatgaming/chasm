      "riskTier": "medium",
      "targetGame": "opence",
      "pluginSource": "OpenCE ai_scripting_follow_target_unit",
      "parametersSchema": { "target": "player" },
      "preconditions": ["the actor is alive and not in a vehicle", "the actor's encounter accepts a follow order"],
      "effects": ["the actor's encounter follows the player"],
      "examplesWhenToUse": ["The NPC agrees to come along.", "A Marine is ordered to escort the Chief."],
      "examplesWhenNotToUse": ["The NPC is hostile.", "The NPC is manning a fixed weapon."],
      "vectorizableText": "npc follows player travel together accompany escort stick close come with",
      "scopes": ["global", "game:opence"],
      "tags": ["movement", "ai", "basic"]
